      "title": "🖥️ CPU & Host Resource Utilization",
      "type": "row"
    },
    {
      "title": "CPU Usage (%) Under Load",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(process_cpu_user_seconds_total[1m]) * 100",
          "legendFormat": "User CPU %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "title": "System CPU Time Series (User vs System)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 1 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(process_cpu_user_seconds_total[1m]) * 100",
          "legendFormat": "CPU User %",
          "refId": "A"
        },
        {
          "expr": "rate(process_cpu_system_seconds_total[1m]) * 100",
          "legendFormat": "CPU System %",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "palette-classic" }
        }
      }
    },
