# ── Copy to `.env` on the server and fill in real values. NEVER commit `.env`. ──
# Generate strong secrets with:  openssl rand -hex 32

# Database (changing the password after first start requires: docker compose down -v)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=loan_verification_db

# Backend auth
JWT_SECRET=

# Public URL users open in the browser (no trailing slash). Used for CORS.
# e.g. http://187.127.175.49  now, https://skylineriskaudits.in after SSL.
CLIENT_URL=

# true when served over HTTPS, false while still on plain http://IP
COOKIE_SECURE=false

# Local Grafana dashboard (port 3001)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Optional integrations (features degrade gracefully when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=

# Automated 3-Tier Database Backup (Option B - Node.js Background Scheduler)
# Optional: Neon DB URL if you want your local VPS database to mirror to Neon DB
NEON_DATABASE_URL=
B2_KEY_ID=0052d0e67de9dca0000000001
B2_APPLICATION_KEY=K0057O0XabYzlE3cbEZNhVtUTvSK1jM
B2_BUCKET_ID=127d204e06073dfea91d0c1a
B2_BUCKET_NAME=skylinerisk-db-backups
