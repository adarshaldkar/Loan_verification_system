  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🐘 PostgreSQL Database Performance",
      "type": "row"
    },
    {
      "title": "Database Query Throughput",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{route=~\"/api/.*\"}[2m]))",
          "legendFormat": "DB Transactions/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Database Connection Pool Health",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "nodejs_active_handles",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 200,
      "title": "⚡ Redis Cache & Message Queue Operations",
      "type": "row"
    },
    {
      "title": "Redis Cache Operations (Hit / Miss / Write)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 14, "x": 0, "y": 9 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (operation, status) (rate(lvms_redis_operations_total[2m]))",
          "legendFormat": "{{operation}} ({{status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Redis Activity Status",
      "type": "stat",
      "gridPos": { "h": 7, "w": 10, "x": 14, "y": 9 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(lvms_redis_operations_total[1m])) or vector(0)",
          "legendFormat": "Total Ops/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    }
  ],
